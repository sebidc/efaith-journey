@using EFaithJourney
@using System.Web
@{
    Layout = "~/_Shared/_Layout.cshtml";
    Page.Title = "e-Faith Journey | Key Takeaways";
    Page.ActiveSection = "Key Takeaways";

    var message = "";
    if (IsPost) {
        var author = (Request.Form["author"] ?? "").Trim();
        var primaryTakeaway = (Request.Form["primaryTakeaway"] ?? "").Trim();
        var applicationPlan = (Request.Form["applicationPlan"] ?? "").Trim();

        if (author.Length > 0 && primaryTakeaway.Length > 0 && applicationPlan.Length > 0) {
            FaithEntryRepository.AddEntry(new FaithEntry {
                Kind = "Key Takeaway",
                Author = author,
                Title = "Final Reflection Check-In",
                Body = "Takeaway: " + primaryTakeaway + " | Application: " + applicationPlan
            });
            message = "Reflection saved successfully through ASP.NET Razor and C#.";
        } else {
            message = "Please fill in your name and answer all reflection questions.";
        }
    }

    var entries = FaithEntryRepository.GetEntries("Key Takeaway");

    var reflectionForm = "<div class=\"form-panel\"><h3>Final Reflection Check-In</h3>";
    if (message.Length > 0) {
        reflectionForm += "<p class=\"" + (message.StartsWith("Please") ? "validation-summary" : "success-message") + "\">" + HttpUtility.HtmlEncode(message) + "</p>";
    }
    reflectionForm += "<p>Select the statements that best reflect your experience and takeaway after exploring our website.</p>" +
        "<form method=\"post\" class=\"book-form\">" +
        "<label>Name or Group<input name=\"author\" required maxlength=\"80\"></label>" +
        
        "<div class=\"question-group\">" +
            "<p><strong>1. What was your primary takeaway from our theology and reflection content?</strong></p>" +
            "<label><input type=\"radio\" name=\"primaryTakeaway\" value=\"I gained a deeper understanding of key theological principles and how faith aligns with real-life challenges.\" required> A: I gained a deeper understanding of key theological principles and how faith aligns with real-life challenges.</label>" +
            "<label><input type=\"radio\" name=\"primaryTakeaway\" value=\"I realized the importance of personal and group reflections in strengthening community and moral values.\"> B: I realized the importance of personal and group reflections in strengthening community and moral values.</label>" +
            "<label><input type=\"radio\" name=\"primaryTakeaway\" value=\"I learned how active participation, empathy, and social responsibility stem from grounded spiritual beliefs.\"> C: I learned how active participation, empathy, and social responsibility stem from grounded spiritual beliefs.</label>" +
            "<label><input type=\"radio\" name=\"primaryTakeaway\" value=\"I gained a clearer view on how individual purpose connects to a broader sense of service and duty.\"> D: I gained a clearer view on how individual purpose connects to a broader sense of service and duty.</label>" +
        "</div>" +

        "<div class=\"question-group\">" +
            "<p><strong>2. How do you plan to apply these learnings in your daily life?</strong></p>" +
            "<label><input type=\"radio\" name=\"applicationPlan\" value=\"By actively engaging in community outreach, advocacy, or service initiatives.\" required> A: By actively engaging in community outreach, advocacy, or service initiatives.</label>" +
            "<label><input type=\"radio\" name=\"applicationPlan\" value=\"By practicing mindful reflection, empathy, and better communication in my daily relationships.\"> B: By practicing mindful reflection, empathy, and better communication in my daily relationships.</label>" +
            "<label><input type=\"radio\" name=\"applicationPlan\" value=\"By aligning my personal and professional goals with strong ethical and spiritual principles.\"> C: By aligning my personal and professional goals with strong ethical and spiritual principles.</label>" +
            "<label><input type=\"radio\" name=\"applicationPlan\" value=\"By continuously seeking knowledge and advocating for fair, compassionate treatment of others.\"> D: By continuously seeking knowledge and advocating for fair, compassionate treatment of others.</label>" +
        "</div>" +

        "<button class=\"button primary\" type=\"submit\">Submit Reflection</button>" +
        "</form></div>";

    var listHtml = "<div class=\"toolbar\"><input type=\"search\" data-entry-search aria-label=\"Search reflections\" placeholder=\"Search reflections\"></div><div class=\"entry-list\">";
    foreach (var entry in entries) {
        listHtml += "<article class=\"entry-card\" data-entry-kind=\"" + HttpUtility.HtmlAttributeEncode(entry.Kind) + "\"><p class=\"entry-meta\">" + HttpUtility.HtmlEncode(entry.Author) + " - " + entry.CreatedAt.ToString("MMM d, yyyy") + "</p><h3>" + HttpUtility.HtmlEncode(entry.Title) + "</h3><p>" + HttpUtility.HtmlEncode(entry.Body) + "</p></article>";
    }
    listHtml += "</div>";

    var panels = new List<dynamic> {
        new { Style = "cover", Title = "Key<br>Takeaways", Subtitle = "Final Reflection<br>& Application", Footer = "Group 1", Kicker = "", Body = "" },
        new { Style = "page", Title = "Reflection", Subtitle = "", Footer = "", Kicker = "Shared Experience", Body = "<p class=\"copy-slot\">Reflect on your journey across our site and share your final insights below.</p>" },
        new { Style = "page", Title = "Also in this book", Subtitle = "", Footer = "", Kicker = "Where to go next", Body = "<ul><li><a href=\"Prayer.cshtml\">Final Prayer or Vow</a></li><li><a href=\"Developers.cshtml\">Developers&rsquo; Information</a></li></ul>" },
        new { Style = "page", Title = "Interactive Reflections", Subtitle = "", Footer = "", Kicker = "Saved by C#", Body = reflectionForm + listHtml },
        new { Style = "page", Title = "The End", Subtitle = "", Footer = "", Kicker = "Closing", Body = "<p class=\"centered\"><em>May every insight become wisdom in action.</em></p>" }
    };
}

@RenderPage("~/_Shared/_Book.cshtml", panels)
