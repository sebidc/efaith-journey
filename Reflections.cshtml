@using EFaithJourney
@using System.Web
@{
    Layout = "~/_Shared/_Layout.cshtml";
    Page.Title = "e-Faith Journey | Reflections";
    Page.ActiveSection = "Reflections";

    var message = "";
    if (IsPost) {
        var author = (Request.Form["author"] ?? "").Trim();
        var title = (Request.Form["title"] ?? "").Trim();
        var body = (Request.Form["body"] ?? "").Trim();
        var scripture = (Request.Form["scripture"] ?? "").Trim();
        var kind = Request.Form["kind"] == "Group Reflection" ? "Group Reflection" : "Reflection";

        if (author.Length > 0 && title.Length > 0 && body.Length >= 60) {
            FaithEntryRepository.AddEntry(new FaithEntry {
                Kind = kind,
                Author = author,
                Title = title,
                Body = body,
                ScriptureReference = scripture
            });
            message = "Reflection saved through ASP.NET Razor and C#.";
        } else {
            message = "Please add a name, title, and at least 60 characters of reflection.";
        }
    }

    var entries = FaithEntryRepository.GetReflectionEntries();
    var entryHtml = "<div class=\"form-panel\"><h3>Add a Reflection</h3>";
    if (message.Length > 0) {
        entryHtml += "<p class=\"" + (message.StartsWith("Please") ? "validation-summary" : "success-message") + "\">" + HttpUtility.HtmlEncode(message) + "</p>";
    }
    entryHtml += "<form method=\"post\" class=\"book-form\"><label>Reflection type<select name=\"kind\"><option>Reflection</option><option>Group Reflection</option></select></label><label>Name or group<input name=\"author\" required maxlength=\"80\"></label><label>Reflection title<input name=\"title\" required maxlength=\"100\"></label><label>Reflection<textarea name=\"body\" required data-character-count=\"#reflection-count\" data-minimum=\"60\"></textarea></label><p id=\"reflection-count\" class=\"field-note\"></p><label>Scripture connection<input name=\"scripture\" maxlength=\"80\"></label><button class=\"button primary\" type=\"submit\">Save reflection</button></form></div>";
    entryHtml += "<div class=\"toolbar\"><select data-entry-filter aria-label=\"Filter reflections\"><option>All</option><option>Reflection</option><option>Group Reflection</option></select><input type=\"search\" data-entry-search aria-label=\"Search reflections\" placeholder=\"Search reflections\"></div>";
    entryHtml += "<div class=\"entry-list\">";
    foreach (var entry in entries) {
        entryHtml += "<article class=\"entry-card\" data-entry-kind=\"" + HttpUtility.HtmlAttributeEncode(entry.Kind) + "\"><p class=\"entry-meta\">" + HttpUtility.HtmlEncode(entry.Kind) + " by " + HttpUtility.HtmlEncode(entry.Author) + " - " + entry.CreatedAt.ToString("MMM d, yyyy") + "</p><h3>" + HttpUtility.HtmlEncode(entry.Title) + "</h3><p>" + HttpUtility.HtmlEncode(entry.Body) + "</p><blockquote>" + HttpUtility.HtmlEncode(entry.ScriptureReference) + "</blockquote></article>";
    }
    entryHtml += "</div>";

    var panels = new List<dynamic> {
        new { Style = "cover", Title = "Reflections", Subtitle = "Personal and Group<br>Faith Learning", Footer = "Group 1", Kicker = "", Body = "" },
        new { Style = "page", Title = "Group Reflection", Subtitle = "", Footer = "", Kicker = "Redistributed from the original book", Body = "<p>Working together as Group 1 taught us that constructing software is much like building a faith community: every line of code requires care, intent, and structural integrity.</p><p>Collaboration made the project more than a technical requirement. It became a practice of patience, listening, correction, and shared responsibility.</p>" },
        new { Style = "page", Title = "Personal Reflection Space", Subtitle = "", Footer = "", Kicker = "Interactive ASP.NET form", Body = entryHtml },
        new { Style = "page", Title = "Reflection Guide", Subtitle = "", Footer = "", Kicker = "Questions for deeper thought", Body = "<ul><li>Where did this project require humility?</li><li>How did code reveal order, purpose, or service?</li><li>What did the group learn about responsibility?</li></ul>" },
        new { Style = "page", Title = "The End", Subtitle = "", Footer = "", Kicker = "Closing", Body = "<p class=\"centered\"><em>Reflection becomes stronger when it leads to patience, service, and shared truth.</em></p>" }
    };
}

@RenderPage("~/_Shared/_Book.cshtml", panels)
