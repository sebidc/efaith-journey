@using EFaithJourney
@using System.Web
@{
    Layout = "~/_Shared/_Layout.cshtml";
    Page.Title = "e-Faith Journey | Reflections";
    Page.ActiveSection = "Reflections";

    var message = "";
    if (IsPost) {
        var author = (Request.Form["author"] ?? "").Trim();
        var title = (Request.Form["title"] ?? "").Trim();
        var body = (Request.Form["body"] ?? "").Trim();
        var scripture = (Request.Form["scripture"] ?? "").Trim();

        if (author.Length > 0 && title.Length > 0 && body.Length >= 60) {
            FaithEntryRepository.AddEntry(new FaithEntry {
                Kind = "Reflection",
                Author = author,
                Title = title,
                Body = body,
                ScriptureReference = scripture
            });
            message = "Individual reflection saved through ASP.NET Razor and C#.";
        } else {
            message = "Please add a name, title, and at least 60 characters of reflection.";
        }
    }

    var groupEntries = FaithEntryRepository.GetEntries("Group Reflection");
    var individualEntries = FaithEntryRepository.GetEntries("Reflection");

    var groupHtml = "<span class=\"section-label\">Group</span><!-- PUT GROUP REFLECTION HERE --><p class=\"copy-slot\">Write the group reflection here. Replace this box. Do not mix individual voices on this page.</p>";
    foreach (var entry in groupEntries) {
        groupHtml += "<article class=\"entry-card\"><p class=\"entry-meta\">" + HttpUtility.HtmlEncode(entry.Author) + " - " + entry.CreatedAt.ToString("MMM d, yyyy") + "</p><h3>" + HttpUtility.HtmlEncode(entry.Title) + "</h3><p>" + HttpUtility.HtmlEncode(entry.Body) + "</p></article>";
    }

    var individualHtml = "<span class=\"section-label\">Individual</span><!-- PUT INDIVIDUAL REFLECTIONS HERE --><p class=\"copy-slot\">Write each member&rsquo;s individual reflection here. Keep this separate from the group page. Replace this box.</p>";
    individualHtml += "<div class=\"form-panel\"><h3>Add an individual reflection</h3>";
    if (message.Length > 0) {
        individualHtml += "<p class=\"" + (message.StartsWith("Please") ? "validation-summary" : "success-message") + "\">" + HttpUtility.HtmlEncode(message) + "</p>";
    }
    individualHtml += "<form method=\"post\" class=\"book-form\"><label>Name<input name=\"author\" required maxlength=\"80\"></label><label>Reflection title<input name=\"title\" required maxlength=\"100\"></label><label>Individual reflection<textarea name=\"body\" required data-character-count=\"#reflection-count\" data-minimum=\"60\"></textarea></label><p id=\"reflection-count\" class=\"field-note\"></p><label>Scripture connection<input name=\"scripture\" maxlength=\"80\"></label><button class=\"button primary\" type=\"submit\">Save individual reflection</button></form></div>";
    foreach (var entry in individualEntries) {
        individualHtml += "<article class=\"entry-card\" data-entry-kind=\"Reflection\"><p class=\"entry-meta\">" + HttpUtility.HtmlEncode(entry.Author) + " - " + entry.CreatedAt.ToString("MMM d, yyyy") + "</p><h3>" + HttpUtility.HtmlEncode(entry.Title) + "</h3><p>" + HttpUtility.HtmlEncode(entry.Body) + "</p></article>";
    }

    var panels = new List<dynamic> {
        new { Style = "cover", Title = "Reflections", Subtitle = "Group, then Individual", Footer = "Group 1", Kicker = "", Body = "" },
        new { Style = "page", Title = "Group Reflection", Subtitle = "", Footer = "", Kicker = "Group only", Body = groupHtml },
        new { Style = "page", Title = "Individual", Subtitle = "", Footer = "", Kicker = "Members", Body = individualHtml },
        new { Style = "page", Title = "Guide", Subtitle = "", Footer = "", Kicker = "Questions for deeper thought", Body = "<ul><li>Where did this project require humility?</li><li>How did code reveal order, purpose, or service?</li><li>What did the group learn about responsibility?</li></ul>" },
        new { Style = "page", Title = "The End", Subtitle = "", Footer = "", Kicker = "Closing", Body = "<p class=\"centered\"><em>Reflection becomes stronger when it leads to patience, service, and shared truth.</em></p>" }
    };
}

@RenderPage("~/_Shared/_Book.cshtml", panels)
