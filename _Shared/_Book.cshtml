@helper RenderPanel(dynamic panel, string contentClass) {
    var isCover = panel.Style == "cover";
    <div class="@contentClass @(isCover ? "cover-style" : "parchment-style")">
        @if (isCover) {
            <div class="gold-frame">
                <div class="cover-title">@Raw(panel.Title)</div>
                <div class="cover-subtitle">@Raw(panel.Subtitle)</div>
                <div class="cover-group">@panel.Footer</div>
            </div>
        } else {
            <div class="watermark">Faith</div>
            <div class="page-header">
                <p>@panel.Kicker</p>
                <h2>@panel.Title</h2>
            </div>
            <div class="page-body">
                @Raw(panel.Body)
            </div>
        }
    </div>
}

@{
    var panels = PageData[0];
    var paperCount = (panels.Count + 1) / 2;
}

<main class="main-stage">
    <div class="lace-border lace-left"></div>

    <button id="prev-btn" class="book-button" type="button" aria-label="Previous book page">
        <span aria-hidden="true">&#8249;</span>
    </button>

    <section id="book" class="book" data-book aria-label="@Page.ActiveSection book">
        @for (var i = 0; i < paperCount; i++) {
            var front = panels[i * 2];
            var hasBack = (i * 2 + 1) < panels.Count;
            var back = hasBack ? panels[i * 2 + 1] : panels[0];
            <article id="p@(i + 1)" class="paper">
                <div class="front">
                    @RenderPanel(front, "front-content")
                </div>
                <div class="back">
                    @RenderPanel(back, "back-content")
                </div>
            </article>
        }
    </section>

    <button id="next-btn" class="book-button" type="button" aria-label="Next book page">
        <span aria-hidden="true">&#8250;</span>
    </button>

    <div class="lace-border lace-right"></div>
</main>
